{
  "name": "dentassist-pro",
  "description": "Dental practice desktop app (Electron + React + SQLite)",
  "author": "DentAssist Pro",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "cross-env VITE_TARGET=web vite --host",
    "prebuild:web": "node scripts/sync-web-public-assets.mjs",
    "build:web": "cross-env VITE_TARGET=web tsc -b && cross-env VITE_TARGET=web vite build",
    "preview:web": "vite preview --outDir dist-web --host",
    "serve:web": "npm run build:web && npm run preview:web",
    "icons:win": "node resize.cjs && node toIco.cjs",
    "prebuild:app": "node resize.cjs && node toIco.cjs",
    "build:app": "tsc -b && vite build",
    "dist": "npm run build:app && electron-builder",
    "dist:dir": "npm run build:app && electron-builder --dir",
    "start:prod": "npm run build:app && electron .",
    "build": "npm run dist",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@supabase/supabase-js": "^2.103.3",
    "better-sqlite3": "^12.9.0",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "i18next": "^26.0.5",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.3",
    "react-router-dom": "^7.14.1",
    "react-to-print": "^3.3.0",
    "recharts": "^3.8.1",
    "sql.js": "^1.14.1",
    "vite-plugin-pwa": "^1.3.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "png-to-ico": "^3.0.1",
    "rcedit": "^5.0.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.dentassist.pro",
    "productName": "DentAssist Pro",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "build/icon.ico",
      "build/icon.png"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "afterPack": "./scripts/afterPack-win-icon.mjs",
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
